      "width": 150.79999999999998,
      "height": 32.5,
      "text": "5. Defensa",
      "originalText": "5. Defensa",
      "fontSize": 26,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
