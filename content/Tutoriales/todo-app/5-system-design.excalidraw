      "locked": false,
      "type": "text",
      "x": 1380,
      "y": 610,
      "width": 271.44,
      "height": 112.5,
      "text": "Primero una caja por\nresponsabilidad, después\nlas flechas, y al final lo\npunteado, que es lo que\nse agrega cuando crece.",
      "originalText": "Primero una caja por\nresponsabilidad, después\nlas flechas, y al final lo\npunteado, que es lo que\nse agrega cuando crece.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "nqcnau0xltenc594",
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
